generator client {
  provider = "prisma-client-js"
}

// SQLite for local dev. Switching to Postgres for production is just
// changing "provider" to "postgresql" and DATABASE_URL in .env - the
// schema below avoids SQLite-specific features so it carries over as-is.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String?
  isAdmin         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  licenses        License[]
  recordings      Recording[]
  creditBalance   Int              @default(0)
  creditPurchases CreditPurchase[]
}

model CreditPurchase {
  id                String    @id @default(cuid())
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id])
  credits           Int
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("pending") // pending | paid
  razorpayInvoiceId String?   @unique
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
}

// One row per desktop Pro Max purchase attempt. Created in "pending" state
// when a Razorpay invoice is issued, flipped to "active" by the webhook once
// payment is confirmed. The key itself is only meaningful once active.
// amountPaise/currency are captured at invoice-creation time so revenue
// reporting is a local query, not a live Razorpay API call per report.
model License {
  id                 String    @id @default(cuid())
  key                String    @unique
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id])
  status             String    @default("pending") // pending | active | revoked
  razorpayInvoiceId  String?   @unique
  amountPaise        Int?
  currency           String    @default("INR")
  activatedAt        DateTime?
  lastValidatedAt    DateTime?
  boundDeviceId    String?
  boundAt    DateTime?
  createdAt          DateTime  @default(now())
}

// Metadata only, logged by the web app after each recording - the video
// itself stays on the customer's own machine (plain browser download), never
// uploaded here. This is what Phase 3 (credit deduction) and Phase 4
// (partner API "recording done" webhook/lookup) will build on.
model Recording {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  barcode    String
  recordedAt DateTime @default(now())
}
