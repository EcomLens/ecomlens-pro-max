generator client {
  provider = "prisma-client-js"
}

// SQLite for local dev. Switching to Postgres for production is just
// changing "provider" to "postgresql" and DATABASE_URL in .env - the
// schema below avoids SQLite-specific features so it carries over as-is.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  licenses     License[]
}

// One row per desktop Pro Max purchase attempt. Created in "pending" state
// when a Razorpay invoice is issued, flipped to "active" by the webhook once
// payment is confirmed. The key itself is only meaningful once active.
// amountPaise/currency are captured at invoice-creation time so revenue
// reporting is a local query, not a live Razorpay API call per report.
model License {
  id                 String    @id @default(cuid())
  key                String    @unique
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id])
  status             String    @default("pending") // pending | active | revoked
  razorpayInvoiceId  String?   @unique
  amountPaise        Int?
  currency           String    @default("INR")
  activatedAt        DateTime?
  lastValidatedAt    DateTime?
  createdAt          DateTime  @default(now())
}
