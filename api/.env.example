# Copy this file to .env and fill in real values. Never commit .env.

# SQLite for local dev - switch to a Postgres URL for production
# (postgresql://user:password@host:5432/dbname) with no other code changes.
DATABASE_URL="file:./dev.db"

# Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard > Settings > Webhooks - set when creating the webhook endpoint
RAZORPAY_WEBHOOK_SECRET=

# Price of the EcomLens Pro Max desktop license, in paise (INR smallest unit).
# Must match whatever price is advertised on the landing page (public/index.html)
# - e.g. 649900 = INR 6,499.00, the current launch price (35% off the
# INR 9,999 regular price). If the launch promo ends, update both this value
# and the landing page copy together.
PRO_MAX_LICENSE_PRICE_PAISE=649900

# Long random string used to sign login session tokens (admin panel access).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000
